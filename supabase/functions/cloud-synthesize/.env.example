# Cloud Synthesizer Environment Variables
# ========================================
# Copy this file to .env.local for local Supabase development.
# NEVER commit .env.local to version control.
#
# Production: Set these via the Supabase Dashboard → Edge Functions → Secrets
# or with: supabase secrets set SUPABASE_GEMINI_API_KEY=...

# Required: Your Google AI Studio / Vertex AI API key for Gemini access.
# The Edge Function will refuse all requests if this is missing.
# Dashboard path: Supabase → Settings → Vault → New Secret
SUPABASE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the Gemini model. Default is gemini-2.0-flash-001.
# Use gemini-2.5-pro-001 for maximum clinical reasoning depth.
GEMINI_MODEL_ID=gemini-2.0-flash-001
